# writing-desk app-owned env — shipped by the .deb (conffile), NOT infra-owned.
# Non-secret only: secrets live in the encrypted store (ADR-0009), never in env files.
# Fixed estate route alias — LiteLLM routes this to the prepared local upstream
# and its fixed provider model. The writer's route-scoped virtual key must allow
# this alias. Loaded LAST in the units, so the app side wins ties.
AGENT_MODEL=local-model-xhigh
