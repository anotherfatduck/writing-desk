# writing-desk host env — infra-owned, 0600, rendered per host by infra.
#   writer-host-01:  /etc/writer-host-01/writer.env   (WRITER1_* names)
#   writer-host-02: /etc/writer-host-02/writer.env (WRITER2_* names)
# Keep exactly ONE name set per host — delete the other shape before rendering.
# App secrets do NOT live here: the store holds them (init from the browser).
# App-level non-secret env (the fixed gateway route) is app-owned — shipped in the .deb as
# /etc/writing-desk/app.env; do not duplicate it here.
OW_PORT=5051
# Public origin (drives handed-out login URLs + Secure cookies)
WRITER1_SITE_URL=https://writer-host-01.example
WRITER2_SITE_URL=https://writer-host-02.example
# LiteLLM gateway via the host stunnel (ADR-0001: plain 127.0.0.1:11440 → mTLS
# edge); the app appends /v1/chat/completions — no trailing /v1 here
WRITER1_LLM_BASE_URL=http://127.0.0.1:11440
WRITER2_LLM_BASE_URL=http://127.0.0.1:11440
# WORKSPACE_ROOT / ORCHESTRATOR_ROOT (workspace contract) confirm the unit-pinned
# /srv/writer-app/* paths — the units' ReadWritePaths are the enforcement, so
# they are documented, not wired as runtime config.
