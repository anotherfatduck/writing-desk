# repo-starter-kit / target-repo .gitignore

# SDD workspace scratch — the managed block says nothing under .superpowers/ is
# tracked or committed. Ignore at the root (durable; propagates to greenfield
# targets via install.sh's .gitignore copy; supersedes a nested .gitignore).
.superpowers/

# Local isolated worktrees
.worktrees/

# graphify code graph — regenerated by `graphify update .` (a query index, not source)
graphify-out/

# the MCP client local permissions / state
.agent/settings.local.json

# Node (tune to your stack)
node_modules/
dist/
dist-orchestrator/
npm-debug.log*
.env
.env.*
!.env.example

# Secrets — sops/age-encrypted, local-only (never committed; the age key is
# the root of trust and lives off-repo at ~/.config/sops/age/keys.txt).
*.sops.env
.sops.yaml

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Playwright MCP browser-session artifacts (console logs, page snapshots)
.playwright-mcp/

# Build artifacts
artifacts/
